{
  "name": "my-universe",
  "version": "1.0.0",
  "type": "module",
  "description": "Complete Universe Simulation — God's Eye View, from Observable Universe to Planetary Surfaces",
  "scripts": {
    "dev": "node scripts/dev-unified.mjs",
    "dev:l0": "vite",
    "dev:explorer": "npm --prefix cosmos/explorer run dev",
    "dev:api": "uvicorn services.api.main:app --reload --app-dir cosmos --port 8000",
    "build": "node scripts/build-unified.mjs",
    "build:l0": "tsc && vite build",
    "build:explorer": "npm --prefix cosmos/explorer run build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit && npm --prefix cosmos/explorer run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:explorer": "npm --prefix cosmos/explorer run test:run",
    "test:e2e:explorer": "npm --prefix cosmos/explorer run test:e2e",
    "test:python": "python -m pytest cosmos/tests -q",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:explorer && npm run test:python",
    "coverage:verify": "python COSMOS-Masterplan/tools/coverage_verifier.py"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "onnxruntime-web": "^1.31.1",
    "postprocessing": "^6.36.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-glsl": "^1.3.1",
    "vitest": "^3.2.7"
  }
}
